# Backend runtime. PORT is intentionally fixed by validation to 9001.
NODE_ENV=development
HOST=0.0.0.0
PORT=9001
# Comma-separated origins allowed by the API. Set the deployed web origin in production.
CORS_ORIGIN=http://localhost:9000

# Browser API base path. Keep /api when Vite/Nginx proxies API requests.
VITE_API_BASE_URL=/api

# Rage Shield uses Groq only from the API server. Never expose this key to the browser.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
RAGE_SHIELD_MAX_REQUESTS=10
